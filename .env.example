# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://socratic:socratic@localhost:5432/socratic
SYNC_DATABASE_URL=postgresql+psycopg2://socratic:socratic@localhost:5432/socratic

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM (OpenAI-compatible) ---
# This backend talks to ANY OpenAI-compatible chat-completions API, not
# specifically OpenAI. Point it at a free-tier provider. Examples:
#
#  Groq (free tier, OpenAI-compatible):
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_MODEL=llama-3.1-8b-instant
#
#  OpenRouter (has free models):
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
#
#  Local Ollama (no key needed, fully free/offline):
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_MODEL=llama3.1
#    LLM_API_KEY=ollama   (any non-empty string works)
#
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=REPLACE_WITH_YOUR_FREE_API_KEY

# Cheaper/faster model used for high-frequency low-stakes calls
# (Diagnostic Agent, Misconception Agent). Can be the same as LLM_MODEL.
LLM_MODEL_FAST=llama-3.1-8b-instant

# --- App ---
ENV=development
MAX_AGENT_CALLS_PER_TURN=4
AGENT_TIMEOUT_SECONDS=6
